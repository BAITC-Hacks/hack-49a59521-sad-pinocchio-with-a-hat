WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
DIARIZATION_ENABLED=true
# Можно указать локальный каталог модели вместо имени Hugging Face.
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# Нужен только на этапе скачивания модели; в закрытом контуре модель можно заранее закешировать.
HF_TOKEN=
MIN_SPEAKERS=1
MAX_SPEAKERS=20
# STORAGE_DIR=./storage
# FFMPEG_DIR=./tools/ffmpeg/bin
