{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/qsamruk/**",
              "ui_kits/sk-kz/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:PT Sans|Rubik))/i]",
        "message": "Font not provided by the design system. Available: PT Sans, Rubik."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|children|color|direction|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ArrowLink> doesn't accept that prop. Declared props: href, children, color, direction, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:right|left)$/]",
        "message": "<ArrowLink> direction must be one of 'right' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|fullWidth|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, fullWidth, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|gold|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'gold' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompanyPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onClick|width|key|ref|className|style|children)$/]",
        "message": "<CompanyPicker> doesn't accept that prop. Declared props: label, onClick, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateTabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onChange|key|ref|className|style|children)$/]",
        "message": "<DateTabs> doesn't accept that prop. Declared props: items, active, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='DotPager'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|active|onChange|key|ref|className|style|children)$/]",
        "message": "<DotPager> doesn't accept that prop. Declared props: count, active, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|excerpt|image|href|moreLabel|onPrev|onNext|key|ref|className|style|children)$/]",
        "message": "<HeroSlide> doesn't accept that prop. Declared props: title, excerpt, image, href, moreLabel, onPrev, onNext."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|image|style|key|ref|className|style|children)$/]",
        "message": "<InfoCard> doesn't accept that prop. Declared props: title, children, image, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangSelect'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|options|onChange|variant|key|ref|className|style|children)$/]",
        "message": "<LangSelect> doesn't accept that prop. Declared props: value, options, onChange, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangSelect'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:corporate|portal)$/]",
        "message": "<LangSelect> variant must be one of 'corporate' | 'portal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|href|height|key|ref|className|style|children)$/]",
        "message": "<LogoTile> doesn't accept that prop. Declared props: src, alt, href, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|children|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: label, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|date|views|image|href|key|ref|className|style|children)$/]",
        "message": "<NewsCard> doesn't accept that prop. Declared props: title, date, views, image, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='NominationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|prefix|nomination|key|ref|className|style|children)$/]",
        "message": "<NominationCard> doesn't accept that prop. Declared props: logo, prefix, nomination."
      },
      {
        "selector": "JSXOpeningElement[name.name='PortalHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|nav|activeIndex|phone|email|lang|searchPlaceholder|loginLabel|registerLabel|onNavigate|onLogin|onRegister|onSearch|key|ref|className|style|children)$/]",
        "message": "<PortalHeader> doesn't accept that prop. Declared props: logoSrc, nav, activeIndex, phone, email, lang, searchPlaceholder, loginLabel, registerLabel, onNavigate, onLogin, onRegister, onSearch."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|onSubmit|style|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: placeholder, value, onChange, onSubmit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionDivider'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|titleColor|style|key|ref|className|style|children)$/]",
        "message": "<SectionDivider> doesn't accept that prop. Declared props: title, titleColor, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|align|underline|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: children, align, underline."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<SectionTitle> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|defaultValue|placeholder|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SelectField> doesn't accept that prop. Declared props: label, options, value, defaultValue, placeholder, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:copyright|socials|links|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: copyright, socials, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|sknewsSrc|items|activeIndex|lang|onLangChange|onNavigate|onSearch|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: logoSrc, sknewsSrc, items, activeIndex, lang, onLangChange, onNavigate, onSearch."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:network|href|size|tone|key|ref|className|style|children)$/]",
        "message": "<SocialIcon> doesn't accept that prop. Declared props: network, href, size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialIcon'] > JSXAttribute[name.name='network'] > Literal[value!=/^(?:facebook|youtube|instagram|telegram)$/]",
        "message": "<SocialIcon> network must be one of 'facebook' | 'youtube' | 'instagram' | 'telegram'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialIcon'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SocialIcon> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCounter'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|tone|key|ref|className|style|children)$/]",
        "message": "<StatCounter> doesn't accept that prop. Declared props: label, value, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCounter'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<StatCounter> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|placeholder|type|disabled|error|onChange|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, defaultValue, placeholder, type, disabled, error, onChange, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
